# PostgreSQL connection string.
# Neon: Dashboard → your project → Connect → choose "Pooled connection" and copy the URL.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Public URL of this API (used in links to uploaded photos/audio).
# Optional on Vercel; for local runs leave as below.
PUBLIC_BASE_URL=http://localhost:8000

# Media bucket names (files are stored in the `media` table)
PHOTO_BUCKET=task-photos
AUDIO_BUCKET=task-audio

# SMTP for OTP e-mails (optional). Use a Gmail *app password*, never your real password.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM=
